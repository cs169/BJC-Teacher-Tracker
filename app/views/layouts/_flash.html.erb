<% flash.each do |name, msg| %>
  <div class="alert alert-<%=alert_class(name) %> alert-dismissible" role="alert">
    <button type="button" class="close" data-dismiss="alert" aria-label="Dismiss">
        <span aria-hidden="true">✖️</span>
    </button>
    <%# Flash messages interpolate user-supplied data (teacher and school names,
        CSV contents), so sanitize rather than trusting them wholesale. A few
        messages contain an intentional link, which sanitize keeps. %>
    <%= sanitize(msg) %>
  </div>
<% end %>
